{% template main %}
{% assign display_mode = trmnl.plugin_settings.custom_fields_values.display_mode | default: 'stats' %}
{% if view == 1 %}
  {% assign lbl_cls = "label label--base lg:label--xlarge bg--gray-75 rounded pl--2 pr--2" %}
  {% assign val_cls = "description description--large lg:description--xxlarge" %}
  {% assign rar_cls = "label label--base lg:label--large" %}
{% else %}
  {% assign lbl_cls = "label label--base lg:label--large bg--gray-75 rounded pl--2 pr--2" %}
  {% assign val_cls = "description description--large lg:description--xlarge" %}
  {% assign rar_cls = "label label--base" %}
{% endif %}

<script>var __mtg = {{ items | json }};</script>

<div class="layout {% unless view == 3 %}layout--row layout--top {% else %}layout--col{% endunless %}  gap--medium h--full m--0 p--0">
  <img class="mtg-img image image-dither image--contain h--full
    {% if view == 1 %}    portrait:hidden lg:portrait:block
    {% elsif view == 2 %}
    {% elsif view == 3 %} portrait:hidden lg:hidden
    {% elsif view == 4 %} portrait:hidden
    {% endif %}
    {% if display_mode == 'art' %}w--full{% endif %}"
    alt="">
  <img class="mtg-img image image-dither image--contain w--full
    {% if view == 1 %}    hidden portrait:block lg:portrait:hidden
    {% elsif view == 2 %} hidden
    {% elsif view == 3 %} hidden portrait:block lg:block
    {% elsif view == 4 %} hidden portrait:block
    {% endif %}"
    alt="">

  {% unless display_mode == 'art' %}
  <div class="flex--col gap--small stretch-x
    {% if view == 1 %}   flex portrait:hidden
    {% elsif view == 2 %}flex portrait:hidden lg:portrait:flex
    {% elsif view == 3 %}hidden portrait:flex
    {% elsif view == 4 %}hidden portrait:m::flex lg:portrait:hidden
    {% endif %}">
    <span class="label label--underline label--large lg:label--xxlarge mtg-name" data-clamp="2"></span>

    <div class="{% if view == 2 %}grid grid--cols-2 portrait:grid--cols-1 gap--small{% else %}flex flex--col{% endif %}">

      <div class="item mtg-type-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.type }}</span>
          <span class="{{ val_cls }} mtg-type" data-clamp="3"></span>
        </div>
      </div>

      <div class="item mtg-mana-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.mana }}</span>
          <span class="{{ val_cls }} mtg-mana"></span>
        </div>
      </div>

      <div class="item mtg-pt-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.pt }}</span>
          <span class="{{ val_cls }} mtg-pt"></span>
        </div>
      </div>

      <div class="item mtg-loyalty-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.loyalty }}</span>
          <span class="{{ val_cls }} mtg-loyalty"></span>
        </div>
      </div>

      {% if view == 1 or view == 3 %}
      <div class="item mtg-rarity-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.rarity }}</span>
          <span class="{{ rar_cls }} mtg-rarity"></span>
        </div>
      </div>

      <div class="item mtg-artist-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.artist }}</span>
          <span class="{{ val_cls }} mtg-artist"></span>
        </div>
      </div>

      <div class="item mtg-price-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.price }}</span>
          <span class="{{ val_cls }} mtg-price"></span>
        </div>
      </div>
      {% endif %}

      {% unless view == 1 %}
      <div class="item mtg-set-name-row hidden">
        <div class="content flex flex--row flex--center-y gap--small">
          <span class="{{ lbl_cls }}">{{ labels.set }}</span>
          <span class="{{ val_cls }} mtg-set-name"></span>
        </div>
      </div>
      {% endunless %}

    </div>

    {% if view == 1 %}
    <div class="mtg-set-row hidden flex flex--row flex--center-y gap--small">
      <img class="mtg-set-icon image--contain w--max-8 h--max-8" alt="">
      <span class="{{ val_cls }} mtg-set-label"></span>
    </div>
    {% endif %}
  </div>
  {% endunless %}
</div>

<div class="title_bar
  {% if view == 1 %}
  lg:portrait:hidden
  {% elsif view == 2 %}

  {% elsif view == 3 %}
  md:hidden portrait:flex lg:flex
  {% elsif view == 4 %}
  lg:portrait:hidden
  {% endif %}">
  <img class="h--8 mtg-set-icon-bar image--stroke-black hidden" alt="">
  <span class="title text--stroke mtg-title"></span>
  <span class="instance text--stroke mtg-instance
  {% if view >= 3 %}
  md:portrait:hidden
  {% endif %}"></span>
</div>

<script>
  (function() {
    var views = Array.from(document.querySelectorAll('.view'));
    var host  = document.currentScript.closest('.view') || document.body;
    var idx   = views.indexOf(host) % 4;
    var item  = (__mtg || [])[idx] || null;
    var name  = '{{ trmnl.plugin_settings.instance_name | escape }}';
    function q(sel) { return host.querySelector(sel); }

    var titleEl = q('.mtg-title');
    var instEl  = q('.mtg-instance');

    if (!item || !item.image_large) {
      if (titleEl) titleEl.textContent = name;
      return;
    }

    host.querySelectorAll('.mtg-img').forEach(function(img) {
      img.src = item.image_large;
      img.alt = item.name || '';
    });

    if (item.set_icon) {
      var barIcon = q('.mtg-set-icon-bar');
      if (barIcon) {
        barIcon.src = item.set_icon;
        barIcon.alt = item.set_code || '';
        barIcon.classList.remove('hidden');
      }
    }

    var nameEl = q('.mtg-name');
    if (nameEl) nameEl.textContent = item.name || '';

    function show2(key, value, extraClass) {
      if (!value && value !== 0) return;
      var val = q('.mtg-' + key);
      var row = q('.mtg-' + key + '-row');
      if (val) {
        val.textContent = String(value);
        if (extraClass) val.classList.add(extraClass);
      }
      if (row) row.classList.remove('hidden');
    }

    function rarityClass(r) {
      r = (r || '').toLowerCase();
      if (r === 'mythic') return 'label--error';
      if (r === 'rare')   return 'label--primary';
      if (r === 'uncommon') return 'label--warning';
      return '';
    }

    show2('type', item.type_line);
    show2('mana', item.mana_cost);

    if (item.power != null && item.toughness != null) {
      show2('pt', item.power + '/' + item.toughness);
    }
    if (item.loyalty != null) {
      show2('loyalty', item.loyalty);
    }

    var rarityLabel = item.rarity ? item.rarity.charAt(0).toUpperCase() + item.rarity.slice(1) : '';
    show2('rarity', rarityLabel, rarityClass(item.rarity));
    show2('artist', item.artist);

    var price = item.price_usd || item.price_eur || '';
    show2('price', price);

    var setYear  = item.set_release_date ? item.set_release_date.slice(0, 4) : '';
    var setLabel = item.set_name || '';
    if (setYear) setLabel += ' (' + setYear + ')';
    show2('set-name', setLabel);

    if (item.set_icon && item.set_name) {
      var iconEl = q('.mtg-set-icon');
      if (iconEl) {
        iconEl.src = item.set_icon;
        iconEl.alt = item.set_name;
      }
      var labelEl = q('.mtg-set-label');
      if (labelEl) labelEl.textContent = setLabel;
      var row = q('.mtg-set-row');
      if (row) row.classList.remove('hidden');
    }

    if (titleEl) titleEl.textContent = item.name || name;
    if (instEl)  instEl.textContent  = setLabel;
  })();
</script>

{% endtemplate %}
